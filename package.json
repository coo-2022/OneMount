{
  "name": "onemount",
  "productName": "OneMount",
  "version": "0.7.0",
  "description": "OneMount — rclone 与 JuiceFS 桌面磁盘管理器",
  "main": "src/bootstrap.cjs",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "install:electron": "node node_modules/electron/install.js",
    "engines:win": "npm run engine:rclone:build && powershell -NoProfile -File scripts/fetch-engines.ps1",
    "release:config": "node scripts/release-config.cjs",
    "test": "node --test tests/*.test.cjs",
    "package:win": "electron-packager . OneMount --platform=win32 --arch=x64 --out=dist --overwrite --asar --icon=assets/icon.ico --ignore=^/dist --ignore=^/tests --ignore=^/scripts --ignore=^/engine-src --ignore=^/screenshots --extra-resource=engines --ignore=^/engines --prune=true --ignore=^/test-results --ignore=^/playwright-report --ignore=^/oauth-clients.local.json --ignore=^/core --ignore=^/.github --ignore=^/installer --ignore=^/electron-builder.config.cjs && node scripts/finish-package.cjs",
    "engine:rclone:generate": "node scripts/generate-rclone-backends.cjs",
    "engine:rclone:build": "powershell -NoProfile -File scripts/build-rclone.ps1",
    "engine:rclone:test": "node scripts/test-rclone-extension.cjs",
    "installer:win": "node scripts/build-installer.cjs",
    "installer:check": "node scripts/check-installer-package.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
